---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'RippleHouse — Home of impactful business growth',
  description = 'RippleHouse helps CPG brands scale profitably through operator-led execution. Built by operators. Designed for growth.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />

    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}logos/ripplehouse-icon.png`} />

    <!-- Once Adobe Fonts kit is provisioned, add: -->
    <!-- <link rel="stylesheet" href="https://use.typekit.net/REPLACE_WITH_KIT_ID.css" /> -->

    <script is:inline src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/jquery.ripples@0.6.3/dist/jquery.ripples-min.js"></script>
  </head>
  <body>
    <slot />
  </body>
</html>

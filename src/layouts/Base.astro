---
import '../styles/global.css';
import { getLocale, useStrings, absoluteUrl, pathFor } from '../i18n/utils';
import { locales, type RouteKey } from '../i18n/routes';

interface Props {
  title?: string;
  description?: string;
  routeKey?: RouteKey;
}

const locale = getLocale(Astro);
const s = useStrings(locale);

const {
  title = s.meta.defaultTitle,
  description = s.meta.defaultDescription,
  routeKey,
} = Astro.props;

const htmlLang = locale === 'fr' ? 'fr-CA' : 'en-CA';
const ogLocale = locale === 'fr' ? 'fr_CA' : 'en_CA';
const ogImage = new URL('/og-image.png', Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' https://code.jquery.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data:; connect-src 'self' https://formspree.io; form-action https://formspree.io; base-uri 'self'; object-src 'none'; frame-ancestors 'none';" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <title>{title}</title>
    <meta name="description" content={description} />

    {routeKey && locales.map((l) => (
      <link
        rel="alternate"
        hreflang={l === 'fr' ? 'fr-CA' : 'en-CA'}
        href={absoluteUrl(Astro.site, pathFor(l, routeKey))}
      />
    ))}
    {routeKey && (
      <link
        rel="alternate"
        hreflang="x-default"
        href={absoluteUrl(Astro.site, pathFor('en', routeKey))}
      />
    )}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:locale" content={ogLocale} />
    <meta
      property="og:locale:alternate"
      content={locale === 'en' ? 'fr_CA' : 'en_CA'}
    />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="RippleHouse" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}logos/main-logo-yellow.svg`} />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}logos/ripplehouse-icon.png`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Once Adobe Fonts kit is provisioned, add: -->
    <!-- <link rel="stylesheet" href="https://use.typekit.net/REPLACE_WITH_KIT_ID.css" /> -->

    <script
      is:inline
      defer
      src="https://code.jquery.com/jquery-3.7.1.min.js"
      integrity="sha384-1H217gwSVyLSIfaLxHbE7dRb3v4mYCKbpQvzx0cegeju1MVsGrX5xXxAvs/HgeFs"
      crossorigin="anonymous"
    ></script>
    <script
      is:inline
      defer
      src="https://cdn.jsdelivr.net/npm/jquery.ripples@0.6.3/dist/jquery.ripples-min.js"
      integrity="sha384-5ZA4JBkTBCN9u6md6s27jm7QrFzL9t2L2rhVbfXzGL1/Q0U79qDOEJ4tnuoy6Mtt"
      crossorigin="anonymous"
    ></script>
  </head>
  <body>
    <slot />
  </body>
</html>

---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Thanks — RippleHouse"
  description="We've got your note."
>
  <Header />

  <main>
    <section class="section pt-24 pb-32 bg-white">
      <div class="section-inner max-w-3xl text-center">
        <span class="eyebrow">Got it</span>
        <h1 class="mt-6 text-display-xl">
          Thanks &mdash; we'll be in touch.
        </h1>
        <p class="mt-8 text-xl md:text-2xl text-ripple-black/75 leading-relaxed">
          Victor will read your note personally and get back to you
          within two business days. In the meantime, if anything
          urgent comes up, his line is open.
        </p>

        <div class="mt-10 inline-block">
          <p class="tagline-mark mb-6">
            Home of impactful business growth
          </p>
        </div>

        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="/" class="btn-primary">
            Back to home
            <span aria-hidden="true">→</span>
          </a>
          <a href="mailto:victor@ripplehouse.ca" class="btn-secondary">
            Email Victor directly
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

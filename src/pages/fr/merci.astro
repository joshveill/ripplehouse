---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getLocale, useStrings, pathFor } from '../../i18n/utils';

const locale = getLocale(Astro);
const s = useStrings(locale);
const t = s.thanks;
const home = pathFor(locale, 'home');
---

<Base
  title={s.meta.thanksTitle}
  description={s.meta.thanksDescription}
  routeKey="thanks"
>
  <Header routeKey="thanks" />

  <main>
    <section class="section pt-24 pb-32 bg-white">
      <div class="section-inner max-w-3xl text-center">
        <span class="eyebrow">{t.eyebrow}</span>
        <h1 class="mt-6 text-display-xl">
          {t.heading}
        </h1>
        <p class="mt-8 text-xl md:text-2xl text-ripple-black/75 leading-relaxed">
          {t.body}
        </p>

        <div class="mt-10 inline-block">
          <p class="tagline-mark mb-6">
            {t.tagline}
          </p>
        </div>

        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href={home} class="btn-primary">
            {t.backHome}
            <span aria-hidden="true">→</span>
          </a>
          <a href="mailto:victor@ripplehouse.ca" class="btn-secondary">
            {t.emailVictor}
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

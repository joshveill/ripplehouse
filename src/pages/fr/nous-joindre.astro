---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getLocale, useStrings, absoluteUrl, pathFor } from '../../i18n/utils';

const locale = getLocale(Astro);
const s = useStrings(locale);
const contact = s.contact;
const thanksUrl = absoluteUrl(Astro.site, pathFor(locale, 'thanks'));
---

<Base
  title={s.meta.contactTitle}
  description={s.meta.contactDescription}
  routeKey="contact"
>
  <Header routeKey="contact" />

  <main class="bg-white">
    <section class="section pt-16 md:pt-20 pb-12">
      <div class="section-inner grid lg:grid-cols-12 gap-12 lg:gap-20">
        <!-- Intro column -->
        <div class="lg:col-span-5">
          <span class="eyebrow">{contact.eyebrow}</span>
          <h1 class="mt-4 text-display-lg leading-[0.95]">
            {contact.heading}
          </h1>

          <p class="mt-8 text-lg md:text-xl text-ripple-black/75 leading-relaxed max-w-md">
            {contact.lede}
          </p>

          <p class="tagline-mark mt-8">
            {contact.tagline}
          </p>
        </div>

        <!-- Form column -->
        <div class="lg:col-span-7">
          <div class="bg-ripple-yellow p-8 md:p-12 relative overflow-hidden">
            <div aria-hidden="true" class="absolute -top-12 -right-12 w-48 h-48 ripple-bg opacity-50"></div>

            <form
              method="POST"
              action="https://formspree.io/f/maqvdlkq"
              class="relative space-y-6"
            >
              <input type="hidden" name="locale" value={locale} />
              <input type="hidden" name="_next" value={thanksUrl} />

              <div class="grid md:grid-cols-2 gap-6">
                <div>
                  <label for="name" class="block font-mono text-xs uppercase tracking-[0.18em] mb-2">
                    {contact.form.nameLabel}
                  </label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    required
                    class="w-full bg-transparent border-b-2 border-ripple-black/40 focus:border-ripple-black focus:outline-none py-2 font-display text-base"
                  />
                </div>

                <div>
                  <label for="email" class="block font-mono text-xs uppercase tracking-[0.18em] mb-2">
                    {contact.form.emailLabel}
                  </label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    class="w-full bg-transparent border-b-2 border-ripple-black/40 focus:border-ripple-black focus:outline-none py-2 font-display text-base"
                  />
                </div>
              </div>

              <div>
                <label for="brand" class="block font-mono text-xs uppercase tracking-[0.18em] mb-2">
                  {contact.form.brandLabel}
                </label>
                <input
                  type="text"
                  id="brand"
                  name="brand"
                  required
                  class="w-full bg-transparent border-b-2 border-ripple-black/40 focus:border-ripple-black focus:outline-none py-2 font-display text-base"
                />
              </div>

              <div>
                <label for="stage" class="block font-mono text-xs uppercase tracking-[0.18em] mb-2">
                  {contact.form.stageLabel}
                </label>
                <select
                  id="stage"
                  name="stage"
                  required
                  class="w-full bg-transparent border-b-2 border-ripple-black/40 focus:border-ripple-black focus:outline-none py-2 font-display text-base appearance-none cursor-pointer"
                >
                  <option value="">{contact.form.stagePlaceholder}</option>
                  {contact.form.stageOptions.map((opt) => <option>{opt}</option>)}
                </select>
              </div>

              <div>
                <label for="interest" class="block font-mono text-xs uppercase tracking-[0.18em] mb-2">
                  {contact.form.interestLabel}
                </label>
                <select
                  id="interest"
                  name="interest"
                  required
                  class="w-full bg-transparent border-b-2 border-ripple-black/40 focus:border-ripple-black focus:outline-none py-2 font-display text-base appearance-none cursor-pointer"
                >
                  <option value="">{contact.form.interestPlaceholder}</option>
                  {contact.form.interestOptions.map((opt) => <option>{opt}</option>)}
                </select>
              </div>

              <div>
                <label for="message" class="block font-mono text-xs uppercase tracking-[0.18em] mb-2">
                  {contact.form.messageLabel}
                </label>
                <textarea
                  id="message"
                  name="message"
                  rows="4"
                  class="w-full bg-transparent border-b-2 border-ripple-black/40 focus:border-ripple-black focus:outline-none py-2 font-display text-base resize-none"
                ></textarea>
              </div>

              <div class="pt-4">
                <button type="submit" class="btn-primary">
                  {contact.form.submit}
                  <span aria-hidden="true">→</span>
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

---
// Reusable logo component using the brand icon.
//
// Sizes:
//   - "md"    → header (default)
//   - "lg"    → larger contexts (footer, contact page)

interface Props {
  variant?: 'dark' | 'light';
  size?: 'md' | 'lg';
  class?: string;
}

const { variant = 'dark', size = 'md', class: className = '' } = Astro.props;

const iconHeight = size === 'lg' ? 'h-14' : 'h-10';
---

<span class={`inline-flex items-center ${className}`}>
  <img
    src="/logos/ripplehouse-icon.png"
    alt="RippleHouse"
    class={`${iconHeight} w-auto`}
  />
</span>

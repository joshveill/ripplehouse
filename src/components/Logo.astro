---
// Reusable logo component.
//
// Variants:
//   - "dark"  → yellow wordmark SVG, for light backgrounds (default)
//   - "light" → white logo PNG, for dark backgrounds
//
// Sizes:
//   - "md"    → header (default)
//   - "lg"    → larger contexts (footer, contact page)

interface Props {
  variant?: 'dark' | 'light';
  size?: 'md' | 'lg';
  class?: string;
}

const { variant = 'dark', size = 'md', class: className = '' } = Astro.props;

const iconHeight = size === 'lg' ? 'h-28' : 'h-12 md:h-24';
const logoSrc = variant === 'light' ? '/logos/ripplehouse-logo-white.png' : '/logos/main-word-yellow.svg';
---

<span class={`inline-flex items-center ${className}`}>
  <img
    src={logoSrc}
    alt="RippleHouse"
    class={`${iconHeight} w-auto`}
  />
</span>

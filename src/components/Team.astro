---
// Team — slides 14–19 of the pitch deck. Photos stay imported here (Astro
// processes them at build time); bio copy lives in the locale strings.
import { Image } from 'astro:assets';
import victorPhoto from '../assets/team/Victor.jpg';
import thibeaudPhoto from '../assets/team/thibeaud.jpg';
import stephPhoto from '../assets/team/steph.jpg';
import graziPhoto from '../assets/team/Grazi.jpg';
import { getLocale, useStrings } from '../i18n/utils';

const s = useStrings(getLocale(Astro)).team;
const photos = [victorPhoto, thibeaudPhoto, stephPhoto, graziPhoto];
const members = s.members.map((member, i) => ({ ...member, photo: photos[i] }));
---

<section id="team" class="section bg-white">
  <div class="section-inner">
    <div class="max-w-3xl mb-16 md:mb-20">
      <span class="eyebrow">{s.eyebrow}</span>
      <h2 class="mt-4 text-display-lg">
        {s.headingLine1}<br />
        {s.headingLine2}
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 md:gap-8">
      {members.map((member) => (
        <article class="flex flex-col h-full">
          <div class="aspect-[4/5] bg-ripple-yellow relative overflow-hidden">
            <Image
              src={member.photo}
              alt={member.name}
              widths={[300, 600, 900]}
              sizes="(min-width: 1024px) 22vw, (min-width: 640px) 45vw, 90vw"
              loading="lazy"
              decoding="async"
              class="absolute inset-0 w-full h-full object-cover"
            />
          </div>

          <div class="mt-6 flex flex-col gap-1 team-card-body">
            <div class="flex flex-col gap-3 min-h-[6.625rem] md:min-h-[7.25rem]">
              <h3 class="text-xl md:text-2xl font-extrabold leading-tight">
                {member.name}
              </h3>
              <p class="font-mono text-sm uppercase tracking-[0.14em] text-ripple-black/60 min-h-[2.5rem]">
                {member.role}
              </p>
            </div>
            <blockquote class="text-base leading-relaxed text-ripple-black/85 italic">
              {member.quote}
            </blockquote>
          </div>
          <div class="team-card-previously pt-5 border-t border-ripple-black/15" style={member.previously ? '' : 'visibility:hidden'}>
            <p class="font-mono text-xs uppercase tracking-[0.14em] text-ripple-black/50 mb-2">
              {s.previouslyLabel}
            </p>
            <p class="text-sm leading-relaxed">
              {member.previously || ' '}
            </p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    function alignPreviously() {
      var bodies = document.querySelectorAll('.team-card-body');
      if (!bodies.length) return;
      // Reset heights first
      bodies.forEach(function (el) { el.style.minHeight = ''; });
      // Only align on desktop (4-col layout)
      if (window.innerWidth < 1024) return;
      var max = 0;
      bodies.forEach(function (el) {
        if (el.offsetHeight > max) max = el.offsetHeight;
      });
      bodies.forEach(function (el) { el.style.minHeight = max + 'px'; });
    }
    window.addEventListener('load', alignPreviously);
    window.addEventListener('resize', alignPreviously);
  })();
</script>

---
import { getLocale, useStrings, pathFor } from '../i18n/utils';
const locale = getLocale(Astro);
const s = useStrings(locale).ctaBanner;
const contact = pathFor(locale, 'contact');
---

<section class="bg-ripple-teal text-ripple-black overflow-hidden relative">
  <!-- Decorative house silhouette -->
  <svg
    aria-hidden="true"
    class="absolute -right-12 -bottom-12 md:-right-20 md:-bottom-20 w-64 md:w-80 lg:w-[500px] h-64 md:h-80 lg:h-[500px] opacity-10"
    viewBox="0 0 100 110"
    fill="currentColor"
  >
    <path d="M50 0 L100 30 L100 110 L0 110 L0 30 Z" />
  </svg>

  <div class="section relative">
    <div class="section-inner grid lg:grid-cols-12 gap-10 items-center">
      <div class="lg:col-span-8">
        <span class="eyebrow">{s.eyebrow}</span>
        <h2 class="mt-6 text-display-xl leading-[0.95]">
          {s.headingLine1}<br />{s.headingLine2}
        </h2>
      </div>

      <div class="lg:col-span-4 flex flex-col items-start lg:items-end gap-6">
        <a href={contact} class="btn-primary text-base">
          {s.cta}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>

---
// Closing CTA — full-bleed Ripple Teal. The teal appears once, here,
// at the moment of the ask. This is intentional: in the deck, teal
// shows up as a single quote-mark accent on slide 15. Reserving it
// for the closing moment honors that rarity and makes the finale
// memorable.
---

<section class="bg-ripple-teal text-ripple-black overflow-hidden relative">
  <!-- Decorative house silhouette -->
  <svg
    aria-hidden="true"
    class="absolute -right-20 -bottom-20 w-[500px] h-[500px] opacity-10"
    viewBox="0 0 100 110"
    fill="currentColor"
  >
    <path d="M50 0 L100 30 L100 110 L0 110 L0 30 Z" />
  </svg>

  <div class="section relative">
    <div class="section-inner grid lg:grid-cols-12 gap-10 items-center">
      <div class="lg:col-span-8">
        <span class="eyebrow">Get in touch</span>
        <h2 class="mt-6 text-display-xl leading-[0.95]">
          Ready to scale<br />the right way?
        </h2>
      </div>

      <div class="lg:col-span-4 flex flex-col items-start lg:items-end gap-6">
        <a href="/get-in-touch" class="btn-primary text-base">
          Let&apos;s talk
          <span aria-hidden="true">→</span>
        </a>
        <div class="font-mono text-sm leading-relaxed">
          <p class="uppercase tracking-[0.14em] mb-2">Direct</p>
          <p>Victor &middot; (438) 883&#8209;4544</p>
          <p>
            <a href="mailto:victor@ripplehouse.ca" class="link-underline">
              victor@ripplehouse.ca
            </a>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

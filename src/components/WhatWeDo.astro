---
import { getLocale, useStrings } from '../i18n/utils';
const s = useStrings(getLocale(Astro)).whatWeDo;
---

<section id="what-we-do" class="section bg-ripple-white">
  <div class="section-inner">
    <div class="max-w-3xl mb-16 md:mb-20">
      <span class="eyebrow">{s.eyebrow}</span>
      <h2 class="mt-4 text-display-lg">
        {s.heading}
      </h2>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-px bg-ripple-black/10">
      {s.services.map((service) => (
        <article class="bg-white p-8 md:p-10 flex flex-col gap-6 group transition-colors duration-300 hover:bg-ripple-yellow/40">
          <div class="flex items-start justify-between">
            <span class="step-number">{service.number}</span>
            <span aria-hidden="true" class="font-mono text-xs uppercase tracking-widest text-ripple-black/40">
              {s.serviceTag}
            </span>
          </div>

          <div>
            <h3 class="text-2xl md:text-3xl font-extrabold leading-tight mb-3">
              {service.title}
            </h3>
            <p class="text-lg font-extrabold text-ripple-black leading-snug">
              {service.outcome}
            </p>
            <p class="mt-3 text-base text-ripple-black/70 leading-relaxed">
              {service.summary}
            </p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

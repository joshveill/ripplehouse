---
// What we do — three offerings from slide 10 of the deck.
// White background, three cards with the yellow house silhouette
// as the step-number marker (graphic primitive on slide 30).

const services = [
  {
    number: '01',
    title: 'Commercial Growth Plan',
    outcome: 'Turn your unfair advantage into scalable & impactful growth.',
    summary: 'A clear, actionable path to profitable scale.',
    scope: [
      'Economics & margins',
      'Product & SKU strategy',
      'Distribution roadmap',
      'Actionable commercial growth plan',
    ],
  },
  {
    number: '02',
    title: 'On-Demand Consulting',
    outcome: 'World class support where it actually matters.',
    summary:
      'Where strategy & execution intersect for support across sales, operations, finance & marketing.',
    scope: [
      'Sales & retail execution',
      'Operations & supply chain',
      'Finance & margin work',
      'Crisis & turnaround moments',
    ],
  },
  {
    number: '03',
    title: 'Fractional CCO',
    outcome: 'Embed commercial leader in your business.',
    summary: 'Accountable for growth, profitability and execution.',
    scope: [
      'Tailored monthly retainer',
      '% of sales or bonus structure',
      '2–3 months of retainer at signing',
      'Equity / sale share for liquidity events',
    ],
  },
];
---

<section id="what-we-do" class="section bg-ripple-white">
  <div class="section-inner">
    <div class="max-w-3xl mb-16 md:mb-20">
      <span class="eyebrow">The RippleHouse Effect</span>
      <h2 class="mt-4 text-display-lg">
        What do we actually do?
      </h2>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-px bg-ripple-black/10">
      {services.map((service) => (
        <article class="bg-white p-8 md:p-10 flex flex-col gap-6 group transition-colors duration-300 hover:bg-ripple-yellow/40">
          <div class="flex items-start justify-between">
            <span class="step-number">{service.number}</span>
            <span aria-hidden="true" class="font-mono text-xs uppercase tracking-widest text-ripple-black/40">
              service
            </span>
          </div>

          <div>
            <h3 class="text-2xl md:text-3xl font-extrabold leading-tight mb-3">
              {service.title}
            </h3>
            <p class="text-lg font-extrabold text-ripple-black leading-snug">
              {service.outcome}
            </p>
            <p class="mt-3 text-base text-ripple-black/70 leading-relaxed">
              {service.summary}
            </p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

---
import Reveal from './Reveal.astro';
import { getLocale, useStrings } from '../i18n/utils';
const s = useStrings(getLocale(Astro)).howItWorks;
const sentence = s.sentence;
---

<section id="how-it-works" class="bg-ripple-yellow text-ripple-black overflow-hidden">
  <div class="section">
    <div class="section-inner grid lg:grid-cols-12 gap-10 lg:gap-16 items-end">
      <div class="lg:col-span-3">
        <span class="eyebrow">{s.eyebrow}</span>
        <p class="mt-4 font-mono text-sm leading-relaxed text-ripple-black/70 max-w-xs">
          {s.blurb}
        </p>
      </div>

      <div class="lg:col-span-9">
        <p class="text-display-md leading-tight">
          {sentence.before}<Reveal>{sentence.reveal1}</Reveal>{sentence.middle1}<Reveal>{sentence.reveal2}</Reveal>{sentence.middle2}<Reveal>{sentence.reveal3}</Reveal>{sentence.spacer}<Reveal>{sentence.reveal4}</Reveal>{sentence.after}
        </p>

      </div>
    </div>
  </div>
</section>

<script is:inline>
(function () {
  function initReveal() {
    var targets = document.querySelectorAll('.reveal');
    if (!targets.length) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      targets.forEach(function (el) {
        el.style.clipPath = 'inset(0)';
        el.style.backgroundSize = '100% 100%';
      });
      return;
    }

    // Add reveal-ready so clip-path kicks in
    targets.forEach(function (el) { el.classList.add('reveal-ready'); });

    var ticking = false;

    function update() {
      var vh = window.innerHeight;
      var startY = vh * 0.85;
      var endY = vh * 0.35;

      targets.forEach(function (el) {
        var rect = el.getBoundingClientRect();
        var raw = (startY - rect.top) / (startY - endY);
        var progress = Math.max(0, Math.min(1, raw));

        var wordProgress = Math.min(1, progress / 0.5);
        var clipRight = 100 - wordProgress * 100;
        el.style.clipPath = 'inset(0 ' + clipRight + '% 0 0)';

        var highlightProgress = Math.max(0, (progress - 0.5) / 0.5);
        el.style.backgroundSize = (highlightProgress * 100) + '% 100%';
      });
      ticking = false;
    }

    function onScroll() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  }

  if (document.readyState === 'complete') {
    initReveal();
  } else {
    window.addEventListener('load', initReveal);
  }
})();
</script>

---
import { getLocale, useStrings } from '../i18n/utils';
const s = useStrings(getLocale(Astro)).about;
---

<section id="about" class="bg-ripple-yellow text-ripple-black">
  <div class="section">
    <div class="section-inner grid lg:grid-cols-12 gap-12 lg:gap-20">
      <!-- Section label -->
      <div class="lg:col-span-4">
        <span class="eyebrow">{s.eyebrow}</span>
        <div class="mt-6 lg:sticky lg:top-32">
          <p class="font-mono text-sm leading-relaxed text-ripple-black/80 max-w-xs">
            {s.blurb}
          </p>
        </div>
      </div>

      <!-- Manifesto -->
      <div class="lg:col-span-8 space-y-12">
        <h2 class="text-display-lg">
          {s.heading}
        </h2>

        <div class="space-y-8 text-lg md:text-xl leading-relaxed max-w-3xl">
          <p>{s.paragraph1}</p>
          <p>{s.paragraph2}</p>
        </div>
      </div>
    </div>
  </div>
</section>

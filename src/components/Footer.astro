---
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---

<footer class="bg-ripple-black text-ripple-white">
  <div class="section py-16 md:py-20">
    <div class="section-inner grid md:grid-cols-12 gap-10 items-start">
      <!-- Brand column -->
      <div class="md:col-span-5">
        <img src="/logos/main-logo-yellow.svg" alt="RippleHouse" class="h-16 w-auto mb-6" />
        <p class="tagline-mark">
          Home of impactful business growth
        </p>
        <p class="mt-6 text-sm text-ripple-white/65 max-w-sm leading-relaxed">
          We help CPG brands scale profitably through operator-led
          execution for impactful growth.
        </p>
      </div>

      <!-- Site links -->
      <div class="md:col-span-3 md:pt-2">
        <p class="font-mono text-xs uppercase tracking-[0.18em] text-ripple-white/45 mb-4">
          Site
        </p>
        <ul class="space-y-2 text-sm">
          <li><a href="/#about" class="link-underline">About us</a></li>
          <li><a href="/#what-we-do" class="link-underline">What we do</a></li>
          <li><a href="/#team" class="link-underline">Team</a></li>
          <li><a href="/get-in-touch" class="link-underline">Get in touch</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div class="md:col-span-4 md:pt-2">
        <p class="font-mono text-xs uppercase tracking-[0.18em] text-ripple-white/45 mb-4">
          Direct
        </p>
        <ul class="space-y-2 text-sm">
          <li>Victor &middot; (438) 883&#8209;4544</li>
          <li>
            <a href="mailto:victor@ripplehouse.ca" class="link-underline">
              victor@ripplehouse.ca
            </a>
          </li>
          <li class="pt-2 text-ripple-white/55">Montréal, Québec</li>
        </ul>
      </div>
    </div>

    <div class="section-inner mt-14 pt-6 border-t border-ripple-white/15 flex flex-col md:flex-row md:justify-between gap-3 font-mono text-xs uppercase tracking-[0.14em] text-ripple-white/55">
      <p>&copy; {year} RippleHouse. All rights reserved.</p>
      <p>Built by operators &middot; designed for growth.</p>
    </div>
  </div>
</footer>

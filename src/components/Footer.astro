---
import { getLocale, useStrings, pathFor } from '../i18n/utils';
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
const locale = getLocale(Astro);
const s = useStrings(locale).footer;
const home = pathFor(locale, 'home');
const contact = pathFor(locale, 'contact');
---

<footer class="bg-ripple-black text-ripple-white">
  <div class="section py-16 md:py-20">
    <div class="section-inner grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-10 items-start">
      <!-- Brand column -->
      <div class="md:col-span-4">
        <img src={`${base}logos/ripplehouse-logo-white-cropped.png`} alt="RippleHouse" loading="lazy" decoding="async" class="h-14 w-auto mb-6" />
        <p class="tagline-mark">
          {s.tagline}
        </p>
        <p class="mt-6 text-sm text-ripple-white/65 max-w-sm leading-relaxed">
          {s.blurb}
        </p>
      </div>

      <!-- Site links -->
      <div class="md:col-span-3 md:col-start-10 text-left">
        <p class="font-mono text-xs uppercase tracking-[0.18em] text-ripple-white/45 mb-4">
          {s.siteLabel}
        </p>
        <ul class="space-y-2 text-sm">
          <li><a href={`${home}#about`} class="link-underline">{s.links.about}</a></li>
          <li><a href={`${home}#what-we-do`} class="link-underline">{s.links.whatWeDo}</a></li>
          <li><a href={`${home}#team`} class="link-underline">{s.links.team}</a></li>
          <li><a href={contact} class="link-underline">{s.links.contact}</a></li>
        </ul>
      </div>
    </div>

    <div class="section-inner mt-14 pt-6 border-t border-ripple-white/15 flex flex-col md:flex-row md:justify-between gap-3 font-mono text-xs uppercase tracking-[0.14em] text-ripple-white/55">
      <p>{s.copyright.replace('{year}', String(year))}</p>
      <p>{s.kicker}</p>
    </div>
  </div>
</footer>
